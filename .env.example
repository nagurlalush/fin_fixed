# CreatorVerse AI — Environment Configuration Example
# Copy this file to .env and configure values for your deployment.

# Environment mode: 'development' or 'production'
FLASK_ENV=development

# Flask Secret Key for session signing
# In production, generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=creatorverse-development-secret-key-change-in-production

# Server Host and Port
PORT=5000
HOST=0.0.0.0

# Database Configuration
# Project-relative or absolute path to SQLite database
CREATORVERSE_DB_PATH=creatorverse.db

# File Storage Configuration
# Project-relative or absolute path to upload storage directory
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH_MB=100

# Security Settings
# Set to 'True' in production when running behind HTTPS/SSL
SESSION_COOKIE_SECURE=False

# Allowed Origins for CORS / Origin header validation (comma-separated, optional)
# ALLOWED_ORIGINS=https://creatorverse.ai,https://app.creatorverse.ai
